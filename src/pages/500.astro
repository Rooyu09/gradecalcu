---
import Layout from '../layouts/Layout.astro';

// SEO details for the 500 Page
const title = "500: Server Error | GradeCalcu";
const description = "An unexpected error occurred while processing your request on GradeCalcu. Return to the homepage or try again.";
---

<Layout title={title} description={description} canonicalUrl="https://gradecalcu.com/500">
	<main class="flex-grow flex items-center justify-center px-4 py-16">
		<div class="max-w-md w-full flex flex-col items-center text-center gap-6">
			<!-- Large status indicator -->
			<div class="relative flex items-center justify-center">
				<span class="text-8xl md:text-9xl font-mono font-bold tracking-tighter text-white opacity-25 select-none animate-pulse">
					500
				</span>
				<div class="absolute text-xl font-bold tracking-tight text-white font-sans mt-2">
					SYSTEM FAULT
				</div>
			</div>

			<!-- Message Card -->
			<div class="vercel-card p-6 sm:p-8 flex flex-col gap-4 w-full border border-vercel-border">
				<h1 class="text-xl font-extrabold tracking-tight text-white">
					Internal Server Error
				</h1>
				<p class="text-xs sm:text-sm text-vercel-light-gray leading-relaxed">
					An unexpected error occurred. Don't worry, all computations run strictly client-side in your local browser window. Try refreshing the page or navigating back home.
				</p>
				
				<div class="h-px bg-vercel-border my-2"></div>
				
				<div class="flex flex-col sm:flex-row gap-3 justify-center">
					<button onclick="window.location.reload()" class="vercel-button text-xs py-2 px-4 inline-flex items-center justify-center gap-2">
						<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
							<path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 1121.21 7.89" />
						</svg>
						Reload Page
					</button>
					<a href="/" class="vercel-button-secondary text-xs py-2 px-4 inline-flex items-center justify-center gap-2">
						Return Home
					</a>
				</div>
			</div>

			<!-- Footer Brand -->
			<div class="text-[10px] text-vercel-gray font-mono">
				GradeCalcu.com &copy; 2026
			</div>
		</div>
	</main>
</Layout>
