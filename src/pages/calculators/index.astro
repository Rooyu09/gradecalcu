---
import DashboardLayout from '../../layouts/DashboardLayout.astro';

// SEO Metadata for the Category Silo Hub
const metadata = {
  title: "Academic Grade Calculators | Fast & Accurate - GradeCalcu",
  description: "Free, privacy-first grade calculators. Calculate your weighted grades, final exam requirements, and class averages instantly with our high-speed tools.",
  keywords: "grade calculators, final grade calculator, weighted grade calculator, class grade tracker, calculate grades",
  canonicalUrl: "https://gradecalcu.com/calculators/"
};

// Data array for our specific calculators to keep the markup clean and scalable
const calculators = [
  {
    title: "Final Grade Calculator",
    description: "Determine exactly what score you need on your final exam to reach your target overall class grade.",
    href: "/calculators/final-grade/",
    badge: "Core",
    badgeColor: "border-blue-500/30 text-blue-400 bg-blue-950/20"
  },
  {
    title: "Weighted Grade Calculator",
    description: "Compute your current class standing based on customized assignment, quiz, and exam percentage weights.",
    href: "/calculators/weighted-grade/",
    badge: "Active",
    badgeColor: "border-emerald-500/30 text-emerald-400 bg-emerald-950/20"
  },
  {
    title: "Semester Grade Calculator",
    description: "Break down your entire semester quarter-by-quarter to forecast your final term results.",
    href: "/calculators/semester-grade/",
    badge: "Active",
    badgeColor: "border-emerald-500/30 text-emerald-400 bg-emerald-950/20"
  },
  {
    title: "Grade Average Calculator",
    description: "Quickly average out simple percentages, points, or letter grades for individual assignments.",
    href: "/calculators/grade-average/",
    badge: "Active",
    badgeColor: "border-emerald-500/30 text-emerald-400 bg-emerald-950/20"
  }
];
---

<DashboardLayout {...metadata} activeTab="none">
  <div class="w-full max-w-4xl mx-auto px-4 py-8">
    
    <!-- Breadcrumb Navigation for Silo Structure -->
    <nav class="flex items-center gap-2 text-xs font-mono text-vercel-gray mb-6">
      <a href="/" class="hover:text-white transition-colors">home</a>
      <span>/</span>
      <span class="text-vercel-light-gray">calculators</span>
    </nav>

    <!-- Hub Header Section -->
    <header class="mb-12">
      <h1 class="text-3xl md:text-4xl font-bold tracking-tight text-white mb-3">
        Grade Calculators
      </h1>
      <p class="text-base text-vercel-light-gray max-w-2xl leading-relaxed">
        Streamlined, local-processing utilities designed to strip the anxiety out of academic tracking. Select a specialized tool below to analyze your scores.
      </p>
    </header>

    <!-- Interactive Tool Grid Layout -->
    <div class="grid gap-6 sm:grid-cols-2">
      {calculators.map((calc) => (
        <a 
          href={calc.badge === "Coming Soon" ? "#" : calc.href} 
          class={`vercel-card block p-6 group transition-all duration-200 ${calc.badge === "Coming Soon" ? "opacity-60 cursor-not-allowed select-none" : "hover:border-vercel-light-gray"}`}
        >
          <div class="flex items-start justify-between gap-4 mb-3">
            <h2 class="text-lg font-semibold text-white group-hover:text-blue-400 transition-colors duration-200">
              {calc.title}
            </h2>
            <span class={`inline-block px-2.5 py-0.5 rounded-full text-[10px] font-mono border ${calc.badgeColor}`}>
              {calc.badge}
            </span>
          </div>
          <p class="text-sm text-vercel-light-gray leading-relaxed">
            {calc.description}
          </p>
          
          {calc.badge !== "Coming Soon" && (
            <div class="mt-4 flex items-center gap-1 text-xs font-mono text-vercel-gray group-hover:text-blue-400 transition-colors duration-200">
              Launch utility 
              <span class="transform group-hover:translate-x-1 transition-transform duration-200">→</span>
            </div>
          )}
        </a>
      ))}
    </div>
  </div>

  <!-- Informational SEO Anchor Block -->
  <div slot="seo-content" class="prose prose-invert max-w-none flex flex-col gap-6 text-vercel-light-gray">
    <section class="flex flex-col gap-4">
      <h2 class="text-xl font-bold text-white">Why use our modular grade tools?</h2>
      <p class="text-sm leading-relaxed">
        Standard academic tracking platforms are notoriously clunky and often gate functionality behind account registrations. Our sub-directory calculators compute formulas completely locally inside your browser client thread. No data is ever transmitted to a server, ensuring 100% privacy and instantaneous recalculations.
      </p>
      <p class="text-sm leading-relaxed">
        To transition between comprehensive tracking setups or alternate grade standards, utilize our dedicated <a href="/gpa/" class="text-vercel-light-gray hover:text-white underline">GPA Hub</a> or regional <a href="/converters/" class="text-vercel-light-gray hover:text-white underline">Conversion Toolkits</a>.
      </p>
    </section>
  </div>
</DashboardLayout>
