</DashboardLayout>

<script>
	// Run client-side calculation
	function initWeightedCalculator() {
		const tableBody = document.getElementById('weighted-table-body');
		const btnAddRow = document.getElementById('btn-add-row');
		const targetGradeInput = document.getElementById('target-grade-input') as HTMLInputElement;

		const currentGradeOutput = document.getElementById('current-grade-output');
		const totalWeightOutput = document.getElementById('total-weight-output');
		const remainingWeightOutput = document.getElementById('remaining-weight-output');
		const requiredScoreOutput = document.getElementById('required-score-output');
		const requiredScoreCard = document.getElementById('required-score-card');
		const requiredScoreContainer = document.getElementById('required-score-container');
		const requiredScoreNote = document.getElementById('required-score-note');

		if (!tableBody || !currentGradeOutput || !totalWeightOutput || !remainingWeightOutput || !requiredScoreOutput) return;

		// Calculate Weighted Grade Function
		function calculate() {
			const rows = tableBody!.querySelectorAll('tr');
			let sumWeightedScores = 0; // Sum of Grade * Weight
			let sumWeights = 0; // Sum of Weights

			rows.forEach(row => {
				const scoreInput = row.querySelector('.row-score') as HTMLInputElement;
				const weightInput = row.querySelector('.row-weight') as HTMLInputElement;

				if (scoreInput && weightInput) {
					const score = parseFloat(scoreInput.value);
					const weight = parseFloat(weightInput.value);

					// Only include rows where both inputs are numbers
					if (!isNaN(score) && !isNaN(weight) && weight > 0) {
						sumWeightedScores += (score * weight);
						sumWeights += weight;
					}
				}
			});

			// Calculations
			let currentGrade = 0;
			if (sumWeights > 0) {
				currentGrade = sumWeightedScores / sumWeights;
			}
			const remainingWeight = Math.max(0, 100 - sumWeights);

			// Update DOM
			currentGradeOutput!.textContent = sumWeights > 0 ? currentGrade.toFixed(2) : "0.00";
			totalWeightOutput!.textContent = sumWeights.toFixed(2) + "%";
			remainingWeightOutput!.textContent = remainingWeight.toFixed(2) + "%";

			// Final Exam Predictor Logic
			const targetGrade = parseFloat(targetGradeInput?.value || "90");
			
			if (isNaN(targetGrade)) {
				requiredScoreOutput!.textContent = "—";
				requiredScoreNote!.textContent = "Please enter a valid target grade.";
				requiredScoreNote!.className = "text-[10px] text-vercel-light-gray mt-1 leading-relaxed";
				requiredScoreCard!.className = "bg-black/40 border border-vercel-border/50 p-4 rounded flex flex-col gap-1 transition-all duration-300";
				return;
			}

			if (remainingWeight <= 0) {
				requiredScoreOutput!.textContent = "—";
				requiredScoreNote!.textContent = "100% of weight is already allocated.";
				requiredScoreNote!.className = "text-[10px] text-amber-500 font-mono mt-1 leading-relaxed";
				requiredScoreCard!.className = "bg-amber-950/20 border border-amber-500/30 p-4 rounded flex flex-col gap-1 transition-all duration-300";
				return;
			}

			// Required Final Grade Score:
			// (sumWeightedScores + FinalGrade * remainingWeight) / 100 = targetGrade
			// FinalGrade = (targetGrade * 100 - sumWeightedScores) / remainingWeight
			const requiredScore = (targetGrade * 100 - sumWeightedScores) / remainingWeight;

			requiredScoreOutput!.textContent = requiredScore.toFixed(2);
			requiredScoreNote!.textContent = `Required final exam grade to achieve ${targetGrade}% overall.`;
			
			if (requiredScore > 100) {
				requiredScoreNote!.textContent = `Warning: Requires a score above 100% (${requiredScore.toFixed(2)}%). Extra credit needed.`;
				requiredScoreNote!.className = "text-[10px] text-red-400 font-mono mt-1 leading-relaxed";
				requiredScoreCard!.className = "bg-red-950/20 border border-red-500/30 p-4 rounded flex flex-col gap-1 transition-all duration-300";
			} else if (requiredScore <= 0) {
				requiredScoreNote!.textContent = `Guaranteed: Target grade secured (needs 0.00% / math: ${requiredScore.toFixed(2)}%).`;
				requiredScoreNote!.className = "text-[10px] text-emerald-400 font-mono mt-1 leading-relaxed";
				requiredScoreCard!.className = "bg-emerald-950/20 border border-emerald-500/30 p-4 rounded flex flex-col gap-1 transition-all duration-300";
			} else {
				requiredScoreNote!.className = "text-[10px] text-vercel-light-gray mt-1 leading-relaxed";
				requiredScoreCard!.className = "bg-black/40 border border-vercel-border/50 p-4 rounded flex flex-col gap-1 transition-all duration-300";
			}
		}

		// Event Delegation for input modifications
		tableBody.addEventListener('input', calculate);
		targetGradeInput?.addEventListener('input', calculate);

		// Delete Row handler
		tableBody.addEventListener('click', (e) => {
			const target = e.target as HTMLElement;
			const deleteBtn = target.closest('.btn-delete-row');
			
			if (deleteBtn) {
				const row = deleteBtn.closest('tr');
				if (row) {
					// Don't delete if it's the last remaining row
					if (tableBody.querySelectorAll('tr').length > 1) {
						row.remove();
						calculate();
					} else {
						// Just clear the inputs if it's the last row
						const scoreInput = row.querySelector('.row-score') as HTMLInputElement;
						const weightInput = row.querySelector('.row-weight') as HTMLInputElement;
						const nameInput = row.querySelector('input[type="text"]') as HTMLInputElement;
						if (nameInput) nameInput.value = '';
						if (scoreInput) scoreInput.value = '';
						if (weightInput) weightInput.value = '';
						calculate();
					}
				}
			}
		});

		// Add Row Handler
		btnAddRow?.addEventListener('click', () => {
			const tr = document.createElement('tr');
			tr.className = 'group table-row-item border-t border-vercel-border/50';
			tr.innerHTML = `
				<td class="py-3 pr-2 sm:pr-4">
					<input 
						type="text" 
						placeholder="e.g., Assignment" 
						class="w-full vercel-input !bg-transparent border-transparent hover:border-vercel-border focus:border-white focus:ring-0 py-1.5 px-1.5 sm:px-2"
					/>
				</td>
				<td class="py-3 pr-2 sm:pr-4">
					<input 
						type="number" 
						placeholder="100" 
						min="0" 
						max="200" 
						step="any"
						class="w-full vercel-input row-score py-1.5 px-1.5 sm:px-2 text-right"
					/>
				</td>
				<td class="py-3 pr-2 sm:pr-4">
					<input 
						type="number" 
						placeholder="10" 
						min="0" 
						max="100" 
						step="any"
						class="w-full vercel-input row-weight py-1.5 px-1.5 sm:px-2 text-right"
					/>
				</td>
				<td class="py-3 text-right">
					<button 
						class="btn-delete-row text-vercel-gray hover:text-red-500 transition-colors p-1"
						aria-label="Delete assessment row"
					>
						<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
							<path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
						</svg>
					</button>
				</td>
			`;
			tableBody.appendChild(tr);
			// Focus the name input in the new row
			const nameInput = tr.querySelector('input[type="text"]') as HTMLInputElement;
			nameInput?.focus();
		});

		// Initial calculation
		calculate();
	}

	// Initialize on page load and navigation
	initWeightedCalculator();
	document.addEventListener('astro:page-load', initWeightedCalculator);
</script>
