---
import DashboardLayout from '../../layouts/DashboardLayout.astro';

// SEO details for the Weighted Grade Calculator page
const title = "Weighted Grade Calculator | Calculate Class Standing - GradeCalcu";
const description = "Easily calculate your current weighted grade class average. Add custom assessment categories like quizzes, homework, and exams to track your grades.";
const keywords = "weighted grade calculator, class grade calculator, calculate weighted average, grade calculator, final exam predictor";
const canonicalUrl = "https://gradecalcu.com/calculators/weighted-grade/";
