---
import DashboardLayout from '../../layouts/DashboardLayout.astro';

// SEO details for the GPA to Percentage page
const title = "GPA to Percentage Converter | 4.0 Scale Translation - GradeCalcu";
const description = "Convert your standard 4.0 GPA into an overall percentage score instantly. Supports strict linear scaling and agency-standard grade distribution curves.";
const keywords = "gpa to percentage, gpa to percentage converter, 4.0 gpa to percentage, convert gpa to percentage, gpa conversion";
const canonicalUrl = "https://gradecalcu.com/converters/gpa-to-percentage/";
---

<DashboardLayout 
	title={title} 
	description={description} 
	keywords={keywords} 
	canonicalUrl={canonicalUrl}
	activeTab="percentage-to-cgpa"
>
	<!-- Breadcrumb Navigation -->
	<nav class="flex items-center gap-2 text-xs font-mono text-vercel-gray mb-6">
		<a href="/" class="hover:text-white transition-colors">home</a>
		<span>/</span>
		<a href="/converters/" class="hover:text-white transition-colors">converters</a>
		<span>/</span>
		<span class="text-vercel-light-gray">gpa to percentage</span>
	</nav>

	<div class="flex flex-col lg:flex-row gap-8 items-start">
		<!-- Calculator Inputs Matrix -->
		<div class="w-full lg:w-3/5 flex flex-col gap-6">
			<div class="vercel-card p-4 sm:p-6 flex flex-col gap-5">
				<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
					<div class="flex flex-col gap-1">
						<h2 class="text-xl font-bold tracking-tight text-white">GPA Conversion Config</h2>
						<p class="text-xs text-vercel-light-gray">Select your scaling method and enter your standard 4.0 GPA score.</p>
					</div>
					
					<!-- Mode Toggle Switcher -->
					<div class="flex bg-black border border-vercel-border p-1 rounded self-start sm:self-auto" role="radiogroup" aria-label="GPA scaling method selection">
						<button 
							id="mode-linear" 
							type="button"
							class="px-3 py-1.5 text-xs font-semibold rounded bg-white text-black transition-all cursor-pointer"
							role="radio"
							aria-checked="true"
						>
							Strict Ratio
						</button>
						<button 
							id="mode-curve" 
							type="button"
							class="px-3 py-1.5 text-xs font-semibold rounded text-vercel-gray hover:text-white transition-all cursor-pointer"
							role="radio"
							aria-checked="false"
						>
							Scale Curve
						</button>
					</div>
				</div>

				<div class="flex flex-col gap-4">
					<!-- GPA Input -->
					<div class="flex flex-col gap-1.5">
						<label class="text-xs font-mono uppercase tracking-wider text-vercel-gray" for="input-gpa">
							Your 4.0 Scale GPA
						</label>
						<div class="relative">
							<input 
								type="number" 
								id="input-gpa" 
								placeholder="e.g. 3.50" 
								min="0" max="4" step="any"
								value="3.50"
								class="w-full vercel-input pr-8"
							/>
							<span class="absolute right-3 top-2.5 text-sm font-mono text-vercel-gray pointer-events-none">/ 4.0</span>
						</div>
					</div>
				</div>

				<!-- Warning Banner -->
				<div 
					id="gpa-warning" 
					class="hidden text-red-400 bg-red-950/30 font-mono text-xs border border-red-900/40 p-3 rounded transition-all duration-200"
					role="alert"
				>
					Warning: Inputted GPA exceeds the standard 4.0 scale maximum boundary!
				</div>
			</div>
		</div>

		<!-- Output Analytics Panel -->
		<div class="w-full lg:w-2/5 flex flex-col gap-6">
			<!-- Live Summary Metrics Card -->
			<div class="vercel-card p-4 sm:p-6 flex flex-col gap-5">
				<h2 class="text-xs uppercase font-mono tracking-widest text-vercel-gray">Conversion Output</h2>
				
				<div class="flex flex-col gap-4">
					<!-- Computed Percentage -->
					<div class="flex flex-col gap-1">
						<span class="text-xs text-vercel-light-gray font-medium">Equivalent Percentage</span>
						<div class="flex items-baseline gap-1">
							<span id="percentage-output" class="text-4xl md:text-5xl font-mono font-bold tracking-tight text-white">87.50</span>
							<span class="text-xl font-mono text-vercel-gray">%</span>
						</div>
						<span id="standing-output" class="text-[10px] text-vercel-gray font-mono mt-1">Academic Standing: Above Average / Honors</span>
					</div>
					
					<!-- Divider -->
					<div class="h-px bg-vercel-border"></div>

					<!-- Method Summary -->
					<div class="flex flex-col gap-0.5">
						<span class="text-[11px] text-vercel-light-gray font-medium">Applied Formula</span>
						<span id="formula-output" class="text-xs font-mono font-semibold text-white mt-0.5">Percentage = (GPA / 4.0) &times; 100</span>
					</div>
				</div>
			</div>

			<!-- Quick Info Card -->
			<div class="vercel-card p-4 sm:p-6 border border-vercel-border flex flex-col gap-2">
				<h3 class="text-xs uppercase font-mono tracking-wider text-vercel-gray">Scaling Methodology</h3>
				<p class="text-xs text-vercel-light-gray leading-relaxed">
					The <strong>Strict Ratio</strong> setting calculates a straight mathematical percentage ratio. The <strong>Scale Curve</strong> uses a bracketed curve mapping standard (matching distribution criteria like WES evaluation keys).
				</p>
			</div>
		</div>
	</div>

	<!-- Programmatic SEO Below-the-fold Content -->
	<div slot="seo-content" class="prose prose-invert max-w-none flex flex-col gap-8 text-vercel-light-gray">
		<section class="flex flex-col gap-4">
			<h2 class="text-2xl font-bold tracking-tight text-white">How to Convert a 4.0 GPA to Percentage</h2>
			<p class="text-sm leading-relaxed">
				Translating your Cumulative Grade Point Average (GPA) from a standard 4.0 scale into an equivalent percentage is commonly required for international job boards, global credit transfers, or applications in countries using percentage-based grading systems. Depending on the evaluation agency or university guidelines, two conversion methods are standard.
			</p>
		</section>

		<section class="flex flex-col gap-6">
			<!-- Linear Ratio -->
			<div class="flex flex-col gap-3">
				<h3 class="text-lg font-bold text-white tracking-tight">1. Strict Linear Ratio Formula</h3>
				<p class="text-sm leading-relaxed">
					This treats the 4.0 scale as a direct linear fraction. It is a straight mathematical calculation mapping GPA directly to percentage.
				</p>
				
				<div class="bg-black/50 border border-vercel-border p-5 rounded font-mono text-xs flex flex-col gap-3 my-2 text-center text-white overflow-x-auto scrollbar-none">
					{"$$Percentage = \\left( \\frac{GPA}{4.0} \\right) \\times 100$$"}
				</div>

				<h4 class="text-xs font-bold uppercase tracking-wider text-white mt-2">Example Calculation:</h4>
				<p class="text-sm leading-relaxed">
					If you have a <strong>3.50 GPA</strong> on the standard 4.0 scale:
				</p>
				<div class="bg-vercel-card border border-vercel-border p-4 rounded font-mono text-xs leading-relaxed">
					Percentage = (3.50 / 4.0) &times; 100 = <strong class="text-white">87.50%</strong>
				</div>
			</div>

			<!-- Bracketed Scale Curve -->
			<div class="flex flex-col gap-3 border-t border-vercel-border/50 pt-6">
				<h3 class="text-lg font-bold text-white tracking-tight">2. Standard Bracketed Scale Curve (WES Mapping)</h3>
				<p class="text-sm leading-relaxed">
					Many global credential evaluation services (such as World Education Services - WES) recognize that grade distributions are non-linear. They use a bracketed curve system where GPAs correspond to specific percentage intervals:
				</p>
				<div class="overflow-x-auto scrollbar-none">
					<table class="w-full text-left border-collapse text-xs my-2">
						<thead>
							<tr class="border-b border-vercel-border text-[10px] text-vercel-gray uppercase font-mono tracking-wider">
								<th class="pb-2 font-medium">GPA Range</th>
								<th class="pb-2 font-medium">Percentage Range</th>
								<th class="pb-2 font-medium">Academic Rating</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-vercel-border/50 text-vercel-light-gray font-mono">
							<tr>
								<td class="py-2.5">3.75 - 4.00</td>
								<td class="py-2.5">90% - 100%</td>
								<td class="py-2.5 text-white font-semibold">Outstanding (High Honors)</td>
							</tr>
							<tr>
								<td class="py-2.5">3.50 - 3.74</td>
								<td class="py-2.5">80% - 89%</td>
								<td class="py-2.5">Above Average (Honors)</td>
							</tr>
							<tr>
								<td class="py-2.5">2.75 - 3.49</td>
								<td class="py-2.5">70% - 79%</td>
								<td class="py-2.5">Average / Good</td>
							</tr>
							<tr>
								<td class="py-2.5">2.00 - 2.74</td>
								<td class="py-2.5">60% - 69%</td>
								<td class="py-2.5">Satisfactory / Pass</td>
							</tr>
							<tr>
								<td class="py-2.5">Below 2.00</td>
								<td class="py-2.5">Below 60%</td>
								<td class="py-2.5">Needs Improvement / Fail</td>
							</tr>
						</tbody>
					</table>
				</div>

				<h4 class="text-xs font-bold uppercase tracking-wider text-white mt-2">Example Calculation (Scale Curve):</h4>
				<p class="text-sm leading-relaxed">
					If you have a <strong>3.50 GPA</strong>, it maps directly to the bottom of the 80%-89% bracket, which evaluates to exactly <strong class="text-white">80.00%</strong>. A <strong>3.00 GPA</strong> maps within the 70%-79% bracket, evaluating linearly to <strong class="text-white">73.00%</strong>.
				</p>
			</div>
		</section>

		<!-- Crawlable FAQ Schema -->
		<section class="border-t border-vercel-border/50 pt-8 flex flex-col gap-4">
			<h3 class="text-lg font-bold text-white tracking-tight">Frequently Asked Questions (FAQ)</h3>
			
			<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
				<div class="flex flex-col gap-1.5">
					<h4 class="text-sm font-semibold text-white">How do I convert a 4.0 GPA to percentage?</h4>
					<p class="text-xs leading-relaxed">
						Using the standard linear setting, divide your GPA by 4.0 and multiply by 100. For example, a 3.0 GPA is a 75% score.
					</p>
				</div>
				<div class="flex flex-col gap-1.5">
					<h4 class="text-sm font-semibold text-white">What is the scale curve conversion?</h4>
					<p class="text-xs leading-relaxed">
						The scale curve uses non-linear mapping brackets (equivalent to WES guidelines) to align GPAs to more realistic candidate percentiles.
					</p>
				</div>
				<div class="flex flex-col gap-1.5">
					<h4 class="text-sm font-semibold text-white">Is a 3.0 GPA equivalent to 75% or 73%?</h4>
					<p class="text-xs leading-relaxed">
						Under strict mathematical linear ratios, a 3.0 GPA is exactly 75%. Under bracketed scale curves, it maps within the 70%-79% range, yielding approximately 73%.
					</p>
				</div>
				<div class="flex flex-col gap-1.5">
					<h4 class="text-sm font-semibold text-white">Is my data secure?</h4>
					<p class="text-xs leading-relaxed">
						Yes. All calculations are executed locally in your browser using JavaScript. No details are transmitted or saved.
					</p>
				</div>
			</div>
		</section>
	</div>

	<!-- JSON-LD FAQ Schema for Search Engines -->
	<script type="application/ld+json" slot="seo-content">
		{
			"@context": "https://schema.org",
			"@type": "FAQPage",
			"mainEntity": [
				{
					"@type": "Question",
					"name": "How do I convert a 4.0 GPA to percentage?",
					"acceptedAnswer": {
						"@type": "Answer",
						"text": "Using the standard linear setting, divide your GPA by 4.0 and multiply by 100. For example, a 3.0 GPA is a 75% score."
					}
				},
				{
					"@type": "Question",
					"name": "What is the scale curve conversion?",
					"acceptedAnswer": {
						"@type": "Answer",
						"text": "The scale curve uses non-linear mapping brackets (equivalent to WES guidelines) to align GPAs to more realistic candidate percentiles."
					}
				},
				{
					"@type": "Question",
					"name": "Is a 3.0 GPA equivalent to 75% or 73%?",
					"acceptedAnswer": {
						"@type": "Answer",
						"text": "Under strict mathematical linear ratios, a 3.0 GPA is exactly 75%. Under bracketed scale curves, it maps within the 70%-79% range, yielding approximately 73%."
					}
				},
				{
					"@type": "Question",
					"name": "Is my data secure?",
					"acceptedAnswer": {
						"@type": "Answer",
						"text": "Yes. All calculations are executed locally in your browser using JavaScript. No details are transmitted or saved."
					}
				}
			]
		}
	</script>
</DashboardLayout>

<script>
	function initGpaConverter() {
		const btnLinear = document.getElementById('mode-linear');
		const btnCurve = document.getElementById('mode-curve');
		const gpaInput = document.getElementById('input-gpa') as HTMLInputElement;
		const warningBanner = document.getElementById('gpa-warning');

		const pctOutput = document.getElementById('percentage-output');
		const standingOutput = document.getElementById('standing-output');
		const formulaOutput = document.getElementById('formula-output');

		if (!gpaInput || !pctOutput || !standingOutput || !formulaOutput) return;

		let currentMode = 'linear'; // 'linear' or 'curve'

		btnLinear?.addEventListener('click', () => {
			if (currentMode === 'linear') return;
			currentMode = 'linear';

			btnLinear.classList.add('bg-white', 'text-black');
			btnLinear.classList.remove('text-vercel-gray', 'hover:text-white');
			btnLinear.setAttribute('aria-checked', 'true');

			btnCurve?.classList.remove('bg-white', 'text-black');
			btnCurve?.classList.add('text-vercel-gray', 'hover:text-white');
			btnCurve?.setAttribute('aria-checked', 'false');

			calculate();
		});

		btnCurve?.addEventListener('click', () => {
			if (currentMode === 'curve') return;
			currentMode = 'curve';

			btnCurve.classList.add('bg-white', 'text-black');
			btnCurve.classList.remove('text-vercel-gray', 'hover:text-white');
			btnCurve.setAttribute('aria-checked', 'true');

			btnLinear?.classList.remove('bg-white', 'text-black');
			btnLinear?.classList.add('text-vercel-gray', 'hover:text-white');
			btnLinear?.setAttribute('aria-checked', 'false');

			calculate();
		});

		// Academic standing descriptors
		function getStanding(gpa: number): string {
			if (gpa >= 3.80) return 'Academic Standing: Outstanding / High Honors';
			if (gpa >= 3.50) return "Academic Standing: Above Average / Honors";
			if (gpa >= 2.75) return 'Academic Standing: Average / Good';
			if (gpa >= 2.00) return 'Academic Standing: Satisfactory / Pass';
			return 'Academic Standing: Needs Improvement / Fail';
		}

		// Bracketed curve calculation logic
		function calculateCurvePercentage(gpa: number): number {
			if (gpa >= 3.75) {
				return 90 + ((gpa - 3.75) / 0.25) * 10;
			} else if (gpa >= 3.50) {
				return 80 + ((gpa - 3.50) / 0.25) * 9;
			} else if (gpa >= 2.75) {
				return 70 + ((gpa - 2.75) / 0.75) * 9;
			} else if (gpa >= 2.00) {
				return 60 + ((gpa - 2.00) / 0.75) * 9;
			} else {
				return Math.max(0, (gpa / 2.00) * 60);
			}
		}

		// Calculation engine
		function calculate() {
			const gpa = parseFloat(gpaInput.value);

			if (isNaN(gpa) || gpa < 0) {
				pctOutput!.textContent = "0.00";
				standingOutput!.textContent = "Please enter a valid GPA score.";
				standingOutput!.className = "text-[10px] text-vercel-gray font-mono mt-1";
				warningBanner?.classList.add('hidden');
				return;
			}

			// Out of bounds check
			if (gpa > 4.0) {
				warningBanner?.classList.remove('hidden');
			} else {
				warningBanner?.classList.add('hidden');
			}

			let percentage = 0;
			if (currentMode === 'linear') {
				percentage = Math.min(100.0, (gpa / 4.0) * 100);
				formulaOutput!.innerHTML = `Percentage = (GPA / 4.0) &times; 100 <span class="text-vercel-gray font-mono">(Linear Scale Ratio)</span>`;
			} else {
				percentage = Math.min(100.0, calculateCurvePercentage(gpa));
				formulaOutput!.innerHTML = `Percentage = CurveMapping(GPA) <span class="text-vercel-gray font-mono">(WES Scale Curve)</span>`;
			}

			// Update output indicators
			pctOutput!.textContent = percentage.toFixed(2);
			standingOutput!.textContent = getStanding(gpa);
			standingOutput!.className = "text-[10px] text-vercel-light-gray font-mono mt-1";
		}

		gpaInput.addEventListener('input', calculate);

		// Trigger initial calculation
		calculate();
	}

	initGpaConverter();
	document.addEventListener('astro:page-load', initGpaConverter);
</script>
