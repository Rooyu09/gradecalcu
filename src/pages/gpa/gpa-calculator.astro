							</tr>
						</thead>
						<tbody id="gpa-table-body" class="divide-y divide-vercel-border/50">
							<!-- Course 1 -->
							<tr class="group table-row-item">
								<td class="py-3 pr-2 sm:pr-4">
									<input 
										type="text" 
										placeholder="e.g., English Composition" 
