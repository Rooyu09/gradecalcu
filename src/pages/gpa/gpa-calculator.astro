---
import DashboardLayout from '../../layouts/DashboardLayout.astro';

// SEO details for the GPA Calculator page
const title = "GPA Calculator | Semester & Term Grade Point Average - GradeCalcu";
const description = "Calculate your semester or term GPA using credit hours and standard letter grades. Add rows dynamically to manage your course load.";
const keywords = "gpa calculator, semester gpa calculator, term gpa calculator, college gpa calculator, high school gpa calculator";
const canonicalUrl = "https://gradecalcu.com/gpa/gpa-calculator/";
