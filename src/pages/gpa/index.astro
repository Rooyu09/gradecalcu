---
import DashboardLayout from '../../layouts/DashboardLayout.astro';

// SEO Metadata for the GPA Hub Silo
const metadata = {
  title: "GPA & CGPA Calculators | High School & College - GradeCalcu",
  description: "Free, premium GPA tracking utilities. Compute your high school or college GPA, semester SGPA, and cumulative CGPA instantly with our local privacy-first tools.",
  keywords: "gpa calculator, cgpa calculator, sgpa calculator, college gpa, high school gpa, cumulative grade point average",
  canonicalUrl: "https://gradecalcu.com/gpa/"
};

// Data array for our GPA sub-calculators
const gpaTools = [
  {
    title: "GPA Calculator",
    description: "Calculate your standard high school or college semester GPA based on credit hours and letter grade scales.",
    href: "/gpa/gpa-calculator/",
    badge: "Core",
    badgeColor: "border-blue-500/30 text-blue-400 bg-blue-950/20"
  },
  {
    title: "CGPA Calculator",
    description: "Combine multiple semesters or term averages to compute your overall Cumulative Grade Point Average.",
    href: "/gpa/cgpa-calculator/",
    badge: "Active",
    badgeColor: "border-emerald-500/30 text-emerald-400 bg-emerald-950/20"
  },
  {
    title: "SGPA Calculator",
    description: "Determine your Semester Grade Point Average with precise weight metrics, ideal for specialized university scales.",
    href: "/gpa/sgpa-calculator/",
    badge: "Active",
    badgeColor: "border-emerald-500/30 text-emerald-400 bg-emerald-950/20"
  }
];
---

<DashboardLayout {...metadata} activeTab="none">
  <div class="w-full max-w-4xl mx-auto px-4 py-8">
    
    <!-- Breadcrumb Navigation -->
    <nav class="flex items-center gap-2 text-xs font-mono text-vercel-gray mb-6">
      <a href="/" class="hover:text-white transition-colors">home</a>
      <span>/</span>
      <span class="text-vercel-light-gray">gpa</span>
    </nav>

    <!-- Hub Header Section -->
    <header class="mb-12">
      <h1 class="text-3xl md:text-4xl font-bold tracking-tight text-white mb-3">
        GPA & CGPA Calculator Hub
      </h1>
      <p class="text-base text-vercel-light-gray max-w-2xl leading-relaxed">
        Whether you are balancing a high school transcript or managing a complex university credit structure, select a tailored tool below to compute your grade metrics.
      </p>
    </header>

    <!-- Interactive Tool Grid Layout -->
    <div class="grid gap-6 sm:grid-cols-2">
      {gpaTools.map((tool) => (
        <a 
          href={tool.badge === "Coming Soon" ? "#" : tool.href} 
          class={`vercel-card block p-6 group transition-all duration-200 ${tool.badge === "Coming Soon" ? "opacity-60 cursor-not-allowed select-none" : "hover:border-vercel-light-gray"}`}
        >
          <div class="flex items-start justify-between gap-4 mb-3">
            <h2 class="text-lg font-semibold text-white group-hover:text-blue-400 transition-colors duration-200">
              {tool.title}
            </h2>
            <span class={`inline-block px-2.5 py-0.5 rounded-full text-[10px] font-mono border ${tool.badgeColor}`}>
              {tool.badge}
            </span>
          </div>
          <p class="text-sm text-vercel-light-gray leading-relaxed">
            {tool.description}
          </p>
          
          {tool.badge !== "Coming Soon" && (
            <div class="mt-4 flex items-center gap-1 text-xs font-mono text-vercel-gray group-hover:text-blue-400 transition-colors duration-200">
              Launch tool 
              <span class="transform group-hover:translate-x-1 transition-transform duration-200">→</span>
            </div>
          )}
        </a>
      ))}
    </div>
  </div>

  <!-- Informational SEO Anchor Block -->
  <div slot="seo-content" class="prose prose-invert max-w-none flex flex-col gap-6 text-vercel-light-gray">
    <section class="flex flex-col gap-4">
      <h2 class="text-xl font-bold text-white">Understanding GPA vs. CGPA Frameworks</h2>
      <p class="text-sm leading-relaxed">
        A Grade Point Average (GPA) evaluates your performance across a single term or semester by weighing individual course grades against their respective credit values. Cumulative Grade Point Average (CGPA), on the other hand, represents the collective mean of all semesters combined throughout an academic lifecycle.
      </p>
      <p class="text-sm leading-relaxed">
        Our engines handle standard unweighted 4.0 scales, weighted 5.0 systems, and credit-hour allocations. By executing calculations client-side without relying on external databases or network loops, your academic statistics remain entirely private and process instantly.
      </p>
    </section>
  </div>
</DashboardLayout>
