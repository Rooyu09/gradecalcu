---
import DashboardLayout from '../../layouts/DashboardLayout.astro';

// SEO details for the SGPA Calculator page
const title = "SGPA Calculator | Semester Grade Point Average - GradeCalcu";
const description = "Calculate your Semester Grade Point Average (SGPA) on a standard 10.0 university scale. Weight grades by course credit hours dynamically.";
const keywords = "sgpa calculator, semester grade point average, 10 point sgpa calculator, vtu sgpa calculator, sppu sgpa calculator";
const canonicalUrl = "https://gradecalcu.com/gpa/sgpa-calculator/";
---

<DashboardLayout 
	title={title} 
	description={description} 
	keywords={keywords} 
	canonicalUrl={canonicalUrl}
	activeTab="cgpa"
>
	<!-- Breadcrumb Navigation -->
	<nav class="flex items-center gap-2 text-xs font-mono text-vercel-gray mb-6">
		<a href="/" class="hover:text-white transition-colors">home</a>
		<span>/</span>
		<a href="/gpa/" class="hover:text-white transition-colors">gpa</a>
		<span>/</span>
		<span class="text-vercel-light-gray">sgpa calculator</span>
	</nav>

	<div class="flex flex-col lg:flex-row gap-8 items-start">
		<!-- Calculator Inputs Matrix -->
		<div class="w-full lg:w-3/5 flex flex-col gap-6">
			<div class="vercel-card p-4 sm:p-6 flex flex-col gap-4">
				<div class="flex items-center justify-between">
					<h2 class="text-xl font-bold tracking-tight text-white">Semester Courses (10.0 Scale)</h2>
					<button 
						id="btn-add-course" 
						class="vercel-button-secondary text-xs flex items-center gap-1.5 py-1.5 px-3"
						type="button"
					>
