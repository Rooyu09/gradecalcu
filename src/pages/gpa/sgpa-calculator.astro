	<!-- Programmatic SEO Below-the-fold Content -->
	<div slot="seo-content" class="prose prose-invert max-w-none flex flex-col gap-8 text-vercel-light-gray">
		<section class="flex flex-col gap-4">
			<h2 class="text-2xl font-bold tracking-tight text-white">How to Calculate Semester SGPA Manually</h2>
			<p class="text-sm leading-relaxed">
				To calculate your credit-weighted Semester Grade Point Average (SGPA) on a 10.0 scale, you multiply the point value of the letter grade received in each course by the credit hours assigned. The sum of these values is divided by the sum of attempted credits.
			</p>
			
			<div class="bg-black/50 border border-vercel-border p-5 rounded font-mono text-xs flex flex-col gap-3 my-2 text-center text-white overflow-x-auto scrollbar-none">
				<div class="text-white font-bold border-b border-vercel-border pb-2 mb-2">
					THE 10-POINT SGPA FORMULA
				</div>
				{"$$SGPA = \\frac{\\sum (Grade\\,Value \\times Credit\\,Hours)}{\\sum Credit\\,Hours}$$"}
			</div>
		</section>

		<section class="flex flex-col gap-4">
			<h3 class="text-lg font-bold text-white tracking-tight">Step-by-Step Calculation Example</h3>
			<p class="text-sm leading-relaxed">
				Suppose you took the following four courses during your semester:
			</p>
			<ul class="list-disc list-inside text-sm pl-2 flex flex-col gap-1.5">
				<li><strong>Math:</strong> Grade O (10 points) &times; 4 credits = 40.0 grade points</li>
				<li><strong>Physics:</strong> Grade A+ (9 points) &times; 4 credits = 36.0 grade points</li>
				<li><strong>Basic Electrical:</strong> Grade A (8 points) &times; 3 credits = 24.0 grade points</li>
				<li><strong>Programming Lab:</strong> Grade O (10 points) &times; 1 credit = 10.0 grade points</li>
			</ul>
			<p class="text-sm leading-relaxed">
				To compute the overall term SGPA:
			</p>
			<ol class="list-decimal list-inside text-sm pl-2 flex flex-col gap-2">
				<li>
					Sum the grade points: <code class="font-mono text-xs text-white bg-vercel-card px-1 py-0.5 rounded border border-vercel-border">40.0 + 36.0 + 24.0 + 10.0 = 110.0</code>.
				</li>
				<li>
					Sum the credit hours: <code class="font-mono text-xs text-white bg-vercel-card px-1 py-0.5 rounded border border-vercel-border">4 + 4 + 3 + 1 = 12</code>.
				</li>
				<li>
					Divide total grade points by total credits: <code class="font-mono text-xs text-white bg-vercel-card px-1 py-0.5 rounded border border-vercel-border">110.0 / 12 = 9.17</code>.
				</li>
			</ol>
			<p class="text-sm leading-relaxed">
				Your final credit-weighted Semester Grade Point Average is <strong>9.17</strong>.
			</p>
		</section>

		<!-- Crawlable FAQ Schema -->
		<section class="border-t border-vercel-border/50 pt-8 flex flex-col gap-4">
			<h3 class="text-lg font-bold text-white tracking-tight">Frequently Asked Questions (FAQ)</h3>
			
			<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
				<div class="flex flex-col gap-1.5">
					<h4 class="text-sm font-semibold text-white">What is SGPA?</h4>
					<p class="text-xs leading-relaxed">
						SGPA stands for Semester Grade Point Average. It measures your academic performance over a single semester or term on a 10.0 grading scale.
					</p>
				</div>
				<div class="flex flex-col gap-1.5">
					<h4 class="text-sm font-semibold text-white">What is the difference between SGPA and CGPA?</h4>
					<p class="text-xs leading-relaxed">
						SGPA reflects a single term's performance, whereas CGPA combines the credit-weighted averages of all semesters completed to represent cumulative performance.
					</p>
				</div>
				<div class="flex flex-col gap-1.5">
					<h4 class="text-sm font-semibold text-white">Are pass/fail classes counted?</h4>
					<p class="text-xs leading-relaxed">
						No. Pass/fail classes do not carry point equivalents on a 10.0 scale and are excluded from SGPA averages.
					</p>
				</div>
				<div class="flex flex-col gap-1.5">
					<h4 class="text-sm font-semibold text-white">Is my data secure?</h4>
					<p class="text-xs leading-relaxed">
						Yes. Calculations are performed locally in your browser using JavaScript. No details are transmitted or saved.
					</p>
				</div>
			</div>
		</section>
	</div>

	<!-- JSON-LD FAQ Schema for Search Engines -->
	<script type="application/ld+json" slot="seo-content">
		{
			"@context": "https://schema.org",
			"@type": "FAQPage",
			"mainEntity": [
				{
					"@type": "Question",
					"name": "What is SGPA?",
					"acceptedAnswer": {
						"@type": "Answer",
						"text": "SGPA stands for Semester Grade Point Average. It measures your academic performance over a single semester or term on a 10.0 grading scale."
					}
				},
				{
					"@type": "Question",
					"name": "What is the difference between SGPA and CGPA?",
					"acceptedAnswer": {
						"@type": "Answer",
						"text": "SGPA reflects a single term's performance, whereas CGPA combines the credit-weighted averages of all semesters completed to represent cumulative performance."
					}
				},
				{
					"@type": "Question",
					"name": "Are pass/fail classes counted?",
					"acceptedAnswer": {
						"@type": "Answer",
						"text": "No. Pass/fail classes do not carry point equivalents on a 10.0 scale and are excluded from SGPA averages."
					}
				},
				{
					"@type": "Question",
					"name": "Is my data secure?",
					"acceptedAnswer": {
						"@type": "Answer",
						"text": "Yes. Calculations are performed locally in your browser using JavaScript. No details are transmitted or saved."
					}
				}
			]
		}
	</script>
</DashboardLayout>

<script>
	function initSgpaCalculator() {
		const tableBody = document.getElementById('sgpa-table-body');
		const btnAddCourse = document.getElementById('btn-add-course');
		const sgpaOutput = document.getElementById('sgpa-output');
		const sgpaStanding = document.getElementById('sgpa-standing');
		const totalCreditsOutput = document.getElementById('total-credits-output');

		if (!tableBody || !sgpaOutput || !totalCreditsOutput) return;

		// Calculate Semester SGPA
		function calculate() {
			const rows = tableBody!.querySelectorAll('tr');
			let totalCredits = 0;
			let totalGradePoints = 0;

			rows.forEach(row => {
				const gradeSelect = row.querySelector('.row-grade-val') as HTMLSelectElement;
				const creditsInput = row.querySelector('.row-credits-val') as HTMLInputElement;

				if (gradeSelect && creditsInput) {
					const gradePoints = parseFloat(gradeSelect.value);
					const credits = parseFloat(creditsInput.value);

					if (!isNaN(gradePoints) && !isNaN(credits) && credits > 0) {
						totalGradePoints += (gradePoints * credits);
						totalCredits += credits;
					}
				}
			});

			const sgpa = totalCredits > 0 ? (totalGradePoints / totalCredits) : 0;

			// Update DOM
			sgpaOutput!.textContent = totalCredits > 0 ? sgpa.toFixed(2) : "0.00";
			totalCreditsOutput!.textContent = totalCredits.toFixed(1);

			// Academic Standing Note
			if (totalCredits === 0) {
				sgpaStanding!.textContent = "Enter courses to calculate standing";
				sgpaStanding!.className = "text-xs text-vercel-gray font-mono";
			} else if (sgpa >= 9.00) {
				sgpaStanding!.textContent = "Academic Standing: Outstanding / S Class";
				sgpaStanding!.className = "text-xs text-emerald-400 font-mono";
			} else if (sgpa >= 7.50) {
				sgpaStanding!.textContent = "Academic Standing: First Class with Distinction";
				sgpaStanding!.className = "text-xs text-blue-400 font-mono";
			} else if (sgpa >= 5.00) {
				sgpaStanding!.textContent = "Academic Standing: Second Class / Satisfactory";
				sgpaStanding!.className = "text-xs text-vercel-light-gray font-mono";
			} else {
				sgpaStanding!.textContent = "Academic Standing: Needs Improvement / Fail";
				sgpaStanding!.className = "text-xs text-red-400 font-mono";
			}
		}

		// Event Delegation for input modifications
		tableBody.addEventListener('input', calculate);
		tableBody.addEventListener('change', calculate);

		// Delete Row handler
		tableBody.addEventListener('click', (e) => {
			const target = e.target as HTMLElement;
			const deleteBtn = target.closest('.btn-delete-row');
			
			if (deleteBtn) {
				const row = deleteBtn.closest('tr');
				if (row) {
					// Don't delete if it's the last remaining row
					if (tableBody.querySelectorAll('tr').length > 1) {
						row.remove();
						calculate();
					} else {
						// Just clear inputs
						const textInput = row.querySelector('input[type="text"]') as HTMLInputElement;
						const creditsInput = row.querySelector('.row-credits-val') as HTMLInputElement;
						const gradeSelect = row.querySelector('.row-grade-val') as HTMLSelectElement;
						if (textInput) textInput.value = '';
						if (creditsInput) creditsInput.value = '';
						if (gradeSelect) gradeSelect.selectedIndex = 0;
						calculate();
					}
				}
			}
		});

		// Add Course Handler
		btnAddCourse?.addEventListener('click', () => {
			const tr = document.createElement('tr');
			tr.className = 'group table-row-item border-t border-vercel-border/50';
			tr.innerHTML = `
				<td class="py-3 pr-2 sm:pr-4">
					<input 
						type="text" 
						placeholder="e.g., Course Name" 
						class="w-full vercel-input !bg-transparent border-transparent hover:border-vercel-border focus:border-white focus:ring-0 py-1.5 px-1.5 sm:px-2"
					/>
				</td>
				<td class="py-3 pr-2 sm:pr-4">
					<select class="w-full vercel-input row-grade-val py-1 px-1.5 sm:px-2 font-mono bg-black border-vercel-border text-white text-xs sm:text-sm">
						<option value="10" selected>O / S (10)</option>
						<option value="9">A+ (9)</option>
						<option value="8">A (8)</option>
						<option value="7">B+ (7)</option>
						<option value="6">B (6)</option>
						<option value="5">C (5)</option>
						<option value="4">P (4)</option>
						<option value="0">F (0)</option>
					</select>
				</td>
				<td class="py-3 pr-2 sm:pr-4">
					<input 
						type="number" 
						placeholder="3" 
						min="0" 
						max="20" 
						step="any"
						class="w-full vercel-input row-credits-val py-1.5 px-1.5 sm:px-2 text-right"
					/>
				</td>
				<td class="py-3 text-right">
					<button 
						class="btn-delete-row text-vercel-gray hover:text-red-500 transition-colors p-1"
						aria-label="Delete course row"
					>
						<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
							<path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
						</svg>
					</button>
				</td>
			`;
			tableBody.appendChild(tr);
			// Focus the name input
			const nameInput = tr.querySelector('input[type="text"]') as HTMLInputElement;
			nameInput?.focus();
		});

		// Initial calculation
		calculate();
	}

	initSgpaCalculator();
	document.addEventListener('astro:page-load', initSgpaCalculator);
</script>
