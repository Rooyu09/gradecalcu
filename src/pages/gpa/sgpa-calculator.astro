		<!-- Output Analytics Panel -->
		<div class="w-full lg:w-2/5 flex flex-col gap-6">
			<!-- Live Summary Metrics Card -->
			<div class="vercel-card p-4 sm:p-6 flex flex-col gap-5">
				<h2 class="text-xs uppercase font-mono tracking-widest text-vercel-gray">Live SGPA Calculation</h2>
				
				<div class="flex flex-col gap-4">
					<!-- SGPA Output -->
					<div class="flex flex-col gap-1">
						<span class="text-xs text-vercel-light-gray font-medium">Computed Semester SGPA</span>
						<div class="flex items-baseline gap-1">
							<span id="sgpa-output" class="text-4xl md:text-5xl font-mono font-bold tracking-tight text-white">9.17</span>
							<span class="text-xl font-mono text-vercel-gray">/ 10.0</span>
						</div>
						<span id="sgpa-standing" class="text-xs text-vercel-gray font-mono">Academic Standing: Outstanding</span>
					</div>
					
					<!-- Divider -->
					<div class="h-px bg-vercel-border"></div>

					<!-- Credits Detail -->
					<div class="flex flex-col gap-0.5">
						<span class="text-[11px] text-vercel-light-gray font-medium">Total Credit Hours Attempted</span>
						<span id="total-credits-output" class="text-lg font-mono font-semibold text-white">12.0</span>
					</div>
				</div>
			</div>

			<!-- Quick Info Card -->
			<div class="vercel-card p-4 sm:p-6 border border-vercel-border flex flex-col gap-2">
				<h3 class="text-xs uppercase font-mono tracking-wider text-vercel-gray">Grade Value Guide</h3>
				<div class="grid grid-cols-2 gap-x-4 gap-y-1 text-[11px] text-vercel-light-gray font-mono">
					<div>O / S = 10</div>
					<div>B = 6</div>
					<div>A+ = 9</div>
					<div>C = 5</div>
					<div>A = 8</div>
					<div>P = 4</div>
					<div>B+ = 7</div>
					<div>F = 0</div>
				</div>
			</div>
		</div>
