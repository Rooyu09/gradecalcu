				</div>

				<!-- Matrix Table -->
				<div class="overflow-x-auto scrollbar-none">
					<table class="w-full text-left border-collapse">
						<thead>
							<tr class="border-b border-vercel-border text-xs text-vercel-gray uppercase font-mono tracking-wider">
								<th class="pb-3 font-medium">Course Title (Optional)</th>
								<th class="pb-3 font-medium w-24 sm:w-32">Grade</th>
								<th class="pb-3 font-medium w-24 sm:w-32 text-right">Credits</th>
								<th class="pb-3 w-8 sm:w-12"></th>
							</tr>
						</thead>
						<tbody id="sgpa-table-body" class="divide-y divide-vercel-border/50">
							<!-- Course 1 -->
							<tr class="group table-row-item">
								<td class="py-3 pr-2 sm:pr-4">
									<input 
										type="text" 
										placeholder="e.g., Engineering Math" 
										class="w-full vercel-input !bg-transparent border-transparent hover:border-vercel-border focus:border-white focus:ring-0 py-1.5 px-1.5 sm:px-2"
										value="Engineering Math"
									/>
								</td>
								<td class="py-3 pr-2 sm:pr-4">
									<select class="w-full vercel-input row-grade-val py-1 px-1.5 sm:px-2 font-mono bg-black border-vercel-border text-white text-xs sm:text-sm">
										<option value="10" selected>O / S (10)</option>
										<option value="9">A+ (9)</option>
										<option value="8">A (8)</option>
										<option value="7">B+ (7)</option>
										<option value="6">B (6)</option>
										<option value="5">C (5)</option>
										<option value="4">P (4)</option>
										<option value="0">F (0)</option>
									</select>
								</td>
								<td class="py-3 pr-2 sm:pr-4">
									<input 
										type="number" 
										placeholder="4" 
										min="0" 
										max="20" 
										step="any"
