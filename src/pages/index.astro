---
import DashboardLayout from '../layouts/DashboardLayout.astro';

// SEO details for the Master Hub Homepage
const title = "Professional Grade Calculator | Fast, Privacy-First Academic Calculators";
const description = "Compute your academic performance instantly. Local processing protects your privacy and guarantees zero delay. Access our suite of Grade, GPA, and Conversion tools.";
const keywords = "grade calculator, gpa calculator, cgpa calculator, sgpa calculator, percentage to cgpa, final grade calculator, weighted grade calculator";
const canonicalUrl = "https://gradecalcu.com/";
---

<DashboardLayout 
	title={title} 
	description={description} 
	keywords={keywords} 
	canonicalUrl={canonicalUrl}
	activeTab="none"
>
	<!-- Master Hub Category Grid -->
	<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
		<!-- Silo 1: Grade Calculators -->
		<a href="/calculators/" class="vercel-card block p-6 group transition-all duration-200 hover:border-vercel-light-gray">
			<div class="flex items-center gap-2.5 mb-4">
				<div class="w-8 h-8 rounded bg-white/5 border border-vercel-border flex items-center justify-center font-mono text-white text-base group-hover:bg-white group-hover:text-black transition-all">
					🧮
				</div>
				<h2 class="text-lg font-bold tracking-tight text-white group-hover:text-blue-400 transition-colors">
					Grade Calculators
				</h2>
			</div>
			
			<p class="text-sm text-vercel-light-gray mb-6 leading-relaxed">
				Determine weighted standing, final exam score requirements, or arithmetic assignment averages locally in your browser.
			</p>
			
			<ul class="space-y-2 text-xs font-mono text-vercel-gray group-hover:text-vercel-light-gray transition-colors">
				<li class="flex items-center gap-2">
					<span class="w-1.5 h-1.5 rounded-full bg-blue-500/50"></span>
					Weighted Grade
				</li>
				<li class="flex items-center gap-2">
					<span class="w-1.5 h-1.5 rounded-full bg-blue-500/50"></span>
					Semester Grade
				</li>
				<li class="flex items-center gap-2">
					<span class="w-1.5 h-1.5 rounded-full bg-blue-500/50"></span>
					Final Grade
				</li>
				<li class="flex items-center gap-2">
					<span class="w-1.5 h-1.5 rounded-full bg-blue-500/50"></span>
					Grade Average
				</li>
			</ul>
			
			<div class="mt-8 flex items-center gap-1 text-xs font-mono text-vercel-gray group-hover:text-blue-400 transition-colors duration-200">
				Open Calculators 
				<span class="transform group-hover:translate-x-1 transition-transform duration-200">→</span>
			</div>
		</a>

		<!-- Silo 2: GPA Hub -->
		<a href="/gpa/" class="vercel-card block p-6 group transition-all duration-200 hover:border-vercel-light-gray">
			<div class="flex items-center gap-2.5 mb-4">
				<div class="w-8 h-8 rounded bg-white/5 border border-vercel-border flex items-center justify-center font-mono text-white text-base group-hover:bg-white group-hover:text-black transition-all">
					🎓
				</div>
				<h2 class="text-lg font-bold tracking-tight text-white group-hover:text-blue-400 transition-colors">
					GPA Hub
				</h2>
			</div>
			
			<p class="text-sm text-vercel-light-gray mb-6 leading-relaxed">
				Balance high school transcripts or manage complex college credits. Stack semesters to analyze your CGPA trajectory.
			</p>
			
			<ul class="space-y-2 text-xs font-mono text-vercel-gray group-hover:text-vercel-light-gray transition-colors">
				<li class="flex items-center gap-2">
					<span class="w-1.5 h-1.5 rounded-full bg-emerald-500/50"></span>
					Semester GPA
				</li>
				<li class="flex items-center gap-2">
					<span class="w-1.5 h-1.5 rounded-full bg-emerald-500/50"></span>
					Cumulative CGPA
				</li>
				<li class="flex items-center gap-2">
					<span class="w-1.5 h-1.5 rounded-full bg-emerald-500/50"></span>
					SGPA Scale
				</li>
			</ul>
			
			<div class="mt-8 flex items-center gap-1 text-xs font-mono text-vercel-gray group-hover:text-blue-400 transition-colors duration-200">
				Open GPA Hub 
				<span class="transform group-hover:translate-x-1 transition-transform duration-200">→</span>
			</div>
		</a>

		<!-- Silo 3: Converters -->
		<a href="/converters/" class="vercel-card block p-6 group transition-all duration-200 hover:border-vercel-light-gray">
			<div class="flex items-center gap-2.5 mb-4">
				<div class="w-8 h-8 rounded bg-white/5 border border-vercel-border flex items-center justify-center font-mono text-white text-base group-hover:bg-white group-hover:text-black transition-all">
					🔄
				</div>
				<h2 class="text-lg font-bold tracking-tight text-white group-hover:text-blue-400 transition-colors">
					Converters
				</h2>
			</div>
			
			<p class="text-sm text-vercel-light-gray mb-6 leading-relaxed">
				Translate academic scores between standard linear distributions, CBSE multiplier scales, and classification classes.
			</p>
			
			<ul class="space-y-2 text-xs font-mono text-vercel-gray group-hover:text-vercel-light-gray transition-colors">
				<li class="flex items-center gap-2">
					<span class="w-1.5 h-1.5 rounded-full bg-violet-500/50"></span>
					CGPA to %
				</li>
				<li class="flex items-center gap-2">
					<span class="w-1.5 h-1.5 rounded-full bg-violet-500/50"></span>
					% to CGPA
				</li>
				<li class="flex items-center gap-2">
					<span class="w-1.5 h-1.5 rounded-full bg-violet-500/50"></span>
					GPA to %
				</li>
			</ul>
			
			<div class="mt-8 flex items-center gap-1 text-xs font-mono text-vercel-gray group-hover:text-blue-400 transition-colors duration-200">
				Open Converters 
				<span class="transform group-hover:translate-x-1 transition-transform duration-200">→</span>
			</div>
		</a>
	</div>

	<!-- Programmatic SEO Below-the-fold Content -->
	<div slot="seo-content" class="prose prose-invert max-w-none flex flex-col gap-8 text-vercel-light-gray">
		<section class="flex flex-col gap-4">
			<h2 class="text-2xl font-bold tracking-tight text-white">Advanced Academic Calculators & Tracking</h2>
			<p class="text-sm leading-relaxed">
				GradeCalcu provides professional, credit-weighted calculation engines designed to strip the anxiety out of academic tracking. By delivering modular, local processing directly in your browser, calculations update instantly with zero delay, securing your transcript privacy with 100% offline data confinement.
			</p>
			<p class="text-sm leading-relaxed">
				Whether you need to project exam goals under a weighted syllabus, stack prior credits into a multi-semester CGPA record, or translate scores for global university transfer credentials, select one of our dedicated toolkits to start tracking your performance.
			</p>
		</section>
	</div>
</DashboardLayout>
